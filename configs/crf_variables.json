{
  "version": "0.1-draft",
  "title": "MMGraph-Med 临床 CRF（MAARS 对齐草案）",
  "outcome": {
    "name": "SCDA",
    "label_cn": "恶性室性心律失常事件",
    "definition": "持续性 VT/VF 导致 ICD 放电或 ATP，或院外心脏骤停",
    "horizon_hours": 48
  },
  "variables": [
    {"name": "patient_id", "label_cn": "患者编号", "category": "META", "type": "string", "required": true, "source": "structured", "schema_path": "patient_id", "missing_rule": "required"},
    {"name": "encounter_id", "label_cn": "住院/就诊编号", "category": "META", "type": "string", "required": true, "source": "structured", "schema_path": "encounter_id", "missing_rule": "required"},
    {"name": "split", "label_cn": "数据划分", "category": "META", "type": "categorical", "allowed_values": ["train", "val", "test"], "required": false, "source": "structured", "schema_path": "split", "missing_rule": "optional"},
    {"name": "age", "label_cn": "年龄", "category": "EHR", "type": "numeric", "unit": "岁", "range": [0, 120], "required": true, "source": "structured", "maars_branch": "EHR", "schema_path": "demographics.age", "missing_rule": "required"},
    {"name": "sex", "label_cn": "性别", "category": "EHR", "type": "categorical", "allowed_values": ["M", "F"], "required": true, "source": "structured", "maars_branch": "EHR", "schema_path": "demographics.sex", "missing_rule": "required"},
    {"name": "BMI", "label_cn": "体重指数", "category": "EHR", "type": "numeric", "unit": "kg/m2", "range": [10, 60], "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "demographics.bmi", "missing_rule": "optional"},
    {"name": "hypertension", "label_cn": "高血压", "category": "EHR", "type": "boolean", "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "diagnoses", "missing_rule": "explicit_missing"},
    {"name": "diabetes", "label_cn": "糖尿病", "category": "EHR", "type": "boolean", "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "diagnoses", "missing_rule": "explicit_missing"},
    {"name": "AF", "label_cn": "心房颤动", "category": "EHR", "type": "boolean", "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "diagnoses", "extraction_variable": "AF", "missing_rule": "explicit_missing"},
    {"name": "NSVT", "label_cn": "非持续性室速", "category": "EHR", "type": "boolean", "required": true, "source": "report", "maars_branch": "EHR", "schema_path": "notes", "extraction_variable": "NSVT", "missing_rule": "explicit_missing"},
    {"name": "syncope", "label_cn": "晕厥", "category": "EHR", "type": "boolean", "required": false, "source": "report", "maars_branch": "EHR", "schema_path": "notes", "extraction_variable": "syncope", "missing_rule": "explicit_missing"},
    {"name": "presyncope", "label_cn": "先兆晕厥", "category": "EHR", "type": "boolean", "required": false, "source": "report", "maars_branch": "EHR", "schema_path": "notes", "extraction_variable": "presyncope", "missing_rule": "explicit_missing"},
    {"name": "family_history_SCD", "label_cn": "猝死家族史", "category": "EHR", "type": "boolean", "required": true, "source": "report", "maars_branch": "EHR", "schema_path": "notes", "extraction_variable": "family_history_SCD", "missing_rule": "explicit_missing"},
    {"name": "dyslipidemia", "label_cn": "高脂血症", "category": "EHR", "type": "boolean", "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "diagnoses", "extraction_variable": "dyslipidemia", "missing_rule": "explicit_missing"},
    {"name": "angina", "label_cn": "心绞痛", "category": "EHR", "type": "boolean", "required": false, "source": "report", "maars_branch": "EHR", "schema_path": "notes", "extraction_variable": "angina", "missing_rule": "explicit_missing"},
    {"name": "dyspnea", "label_cn": "呼吸困难/气短", "category": "EHR", "type": "boolean", "required": false, "source": "report", "maars_branch": "EHR", "schema_path": "notes", "extraction_variable": "dyspnea", "missing_rule": "explicit_missing"},
    {"name": "smoking", "label_cn": "吸烟史", "category": "EHR", "type": "boolean", "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "notes", "missing_rule": "explicit_missing"},
    {"name": "NYHA", "label_cn": "NYHA 心功能分级", "category": "EHR", "type": "categorical", "allowed_values": ["I", "II", "III", "IV"], "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "diagnoses", "missing_rule": "optional"},
    {"name": "prior_MI", "label_cn": "既往心肌梗死", "category": "EHR", "type": "boolean", "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "diagnoses", "missing_rule": "explicit_missing"},
    {"name": "prior_stroke", "label_cn": "既往脑卒中", "category": "EHR", "type": "boolean", "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "diagnoses", "missing_rule": "explicit_missing"},
    {"name": "beta_blocker", "label_cn": "β受体阻滞剂", "category": "EHR", "type": "boolean", "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "medications", "missing_rule": "optional"},
    {"name": "amiodarone", "label_cn": "胺碘酮", "category": "EHR", "type": "boolean", "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "medications", "missing_rule": "optional"},
    {"name": "ICD_device", "label_cn": "ICD/CRT-D 植入", "category": "EHR", "type": "boolean", "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "medications", "missing_rule": "optional"},
    {"name": "potassium", "label_cn": "血钾", "category": "EHR", "type": "numeric", "unit": "mmol/L", "range": [1.5, 8], "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "labs", "extraction_variable": "potassium", "missing_rule": "optional"},
    {"name": "NT_proBNP", "label_cn": "NT-proBNP", "category": "EHR", "type": "numeric", "unit": "pg/mL", "range": [0, 50000], "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "labs", "extraction_variable": "NT_proBNP", "missing_rule": "optional"},
    {"name": "eGFR", "label_cn": "eGFR", "category": "EHR", "type": "numeric", "unit": "ml/min/1.73m2", "range": [1, 150], "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "labs", "extraction_variable": "eGFR", "missing_rule": "optional"},
    {"name": "HbA1c", "label_cn": "糖化血红蛋白", "category": "EHR", "type": "numeric", "unit": "%", "range": [3, 20], "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "labs", "extraction_variable": "HbA1c", "missing_rule": "optional"},
    {"name": "LDL", "label_cn": "LDL-C", "category": "EHR", "type": "numeric", "unit": "mmol/L", "range": [0.2, 15], "required": false, "source": "structured", "maars_branch": "EHR", "schema_path": "labs", "extraction_variable": "LDL", "missing_rule": "optional"},
    {"name": "LVEF", "label_cn": "左室射血分数", "category": "CIR", "type": "numeric", "unit": "%", "range": [5, 90], "required": true, "source": "report", "maars_branch": "CIR", "schema_path": "echo[].lvef", "extraction_variable": "LVEF", "missing_rule": "optional"},
    {"name": "IVS_thickness", "label_cn": "室间隔厚度", "category": "CIR", "type": "numeric", "unit": "mm", "range": [3, 40], "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "echo[].ivs", "extraction_variable": "IVS_thickness", "missing_rule": "optional"},
    {"name": "LA_diameter", "label_cn": "左房内径", "category": "CIR", "type": "numeric", "unit": "mm", "range": [20, 80], "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "echo[].la", "extraction_variable": "LA_diameter", "missing_rule": "optional"},
    {"name": "LVEDV", "label_cn": "左室舒张末容积", "category": "CIR", "type": "numeric", "unit": "ml", "range": [40, 400], "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "echo[].lvedv", "extraction_variable": "LVEDV", "missing_rule": "optional"},
    {"name": "LVESV", "label_cn": "左室收缩末容积", "category": "CIR", "type": "numeric", "unit": "ml", "range": [10, 300], "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "echo[].lvesv", "extraction_variable": "LVESV", "missing_rule": "optional"},
    {"name": "LVOT_gradient", "label_cn": "左室流出道压差", "category": "CIR", "type": "numeric", "unit": "mmHg", "range": [0, 200], "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "echo[].lvot", "extraction_variable": "LVOT_gradient", "missing_rule": "optional"},
    {"name": "LGE_present", "label_cn": "LGE 延迟强化", "category": "CIR", "type": "boolean", "required": true, "source": "report", "maars_branch": "CMR", "schema_path": "cmr[].lge", "extraction_variable": "LGE_present", "missing_rule": "optional"},
    {"name": "LGE_percent", "label_cn": "LGE 占左室心肌百分比", "category": "CIR", "type": "numeric", "unit": "%", "range": [0, 80], "required": false, "source": "report", "maars_branch": "CMR", "schema_path": "cmr[].lge_percent", "extraction_variable": "LGE_percent", "missing_rule": "optional"},
    {"name": "LGE_pattern", "label_cn": "LGE 分布模式", "category": "CIR", "type": "categorical", "allowed_values": ["心内膜下", "中层", "心外膜下", "透壁", "斑片状"], "required": false, "source": "report", "maars_branch": "CMR", "schema_path": "cmr[].lge_pattern", "extraction_variable": "LGE_pattern", "missing_rule": "optional"},
    {"name": "SAM", "label_cn": "二尖瓣收缩期前向运动", "category": "CIR", "type": "boolean", "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "echo[].sam", "extraction_variable": "SAM", "missing_rule": "explicit_missing"},
    {"name": "thrombus", "label_cn": "心腔内血栓", "category": "CIR", "type": "boolean", "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "echo[].thrombus", "extraction_variable": "thrombus", "missing_rule": "explicit_missing"},
    {"name": "pericardial_effusion", "label_cn": "心包积液", "category": "CIR", "type": "boolean", "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "echo[].pericardial_effusion", "extraction_variable": "pericardial_effusion", "missing_rule": "explicit_missing"},
    {"name": "mitral_regurgitation", "label_cn": "二尖瓣反流程度", "category": "CIR", "type": "categorical", "allowed_values": ["轻度", "中度", "重度"], "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "echo[].mr", "extraction_variable": "mitral_regurgitation", "missing_rule": "optional"},
    {"name": "TR_severity", "label_cn": "三尖瓣反流程度", "category": "CIR", "type": "categorical", "allowed_values": ["轻度", "中度", "重度"], "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "echo[].tr", "extraction_variable": "TR_severity", "missing_rule": "optional"},
    {"name": "wall_motion_abnormal", "label_cn": "室壁运动异常", "category": "CIR", "type": "boolean", "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "echo[].wall_motion", "extraction_variable": "wall_motion_abnormal", "missing_rule": "explicit_missing"},
    {"name": "RV_dysfunction", "label_cn": "右室收缩功能减低", "category": "CIR", "type": "boolean", "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "echo[].rv", "extraction_variable": "RV_dysfunction", "missing_rule": "explicit_missing"},
    {"name": "HR", "label_cn": "心率", "category": "ECG", "type": "numeric", "unit": "次/分", "range": [20, 250], "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "ecg[].hr", "extraction_variable": "HR", "missing_rule": "optional"},
    {"name": "QRS", "label_cn": "QRS 时限", "category": "ECG", "type": "numeric", "unit": "ms", "range": [40, 250], "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "ecg[].qrs_ms", "extraction_variable": "QRS", "missing_rule": "optional"},
    {"name": "QTc", "label_cn": "QTc 间期", "category": "ECG", "type": "numeric", "unit": "ms", "range": [250, 700], "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "ecg[].qtc_ms", "extraction_variable": "QTc", "missing_rule": "optional"},
    {"name": "rhythm", "label_cn": "基础节律", "category": "ECG", "type": "categorical", "allowed_values": ["窦性心律", "心房颤动", "其他"], "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "ecg[].rhythm", "missing_rule": "optional"},
    {"name": "PVC", "label_cn": "室性早搏", "category": "ECG", "type": "boolean", "required": false, "source": "report", "maars_branch": "CIR", "schema_path": "ecg[].pvc", "extraction_variable": "PVC", "missing_rule": "explicit_missing"},
    {"name": "LGE_image_available", "label_cn": "是否有 LGE-CMR 原始图像", "category": "CMR", "type": "boolean", "required": true, "source": "image", "maars_branch": "CMR", "schema_path": "cmr[].path", "missing_rule": "required"},
    {"name": "SCDA_event", "label_cn": "SCDA 事件", "category": "OUTCOME", "type": "boolean", "required": true, "source": "structured", "schema_path": "labels.event", "missing_rule": "required"},
    {"name": "event_type", "label_cn": "事件类型", "category": "OUTCOME", "type": "categorical", "allowed_values": ["VT", "VF", "SCD", "ICD_shock", "none"], "required": true, "source": "structured", "schema_path": "labels.event", "missing_rule": "required"},
    {"name": "event_time", "label_cn": "事件时间", "category": "OUTCOME", "type": "datetime", "required": false, "source": "structured", "schema_path": "labels.event_time", "missing_rule": "conditional"},
    {"name": "event_source", "label_cn": "事件来源", "category": "OUTCOME", "type": "string", "required": false, "source": "structured", "schema_path": "labels.event_source", "missing_rule": "optional"},
    {"name": "follow_up_days", "label_cn": "随访天数", "category": "OUTCOME", "type": "numeric", "unit": "天", "range": [0, 3650], "required": false, "source": "structured", "schema_path": "labels.follow_up_days", "missing_rule": "optional"},
    {"name": "window_start", "label_cn": "时间窗开始", "category": "OUTCOME", "type": "datetime", "required": true, "source": "structured", "schema_path": "window.start", "missing_rule": "required"},
    {"name": "window_end", "label_cn": "时间窗结束", "category": "OUTCOME", "type": "datetime", "required": true, "source": "structured", "schema_path": "window.end", "missing_rule": "required"}
  ]
}
